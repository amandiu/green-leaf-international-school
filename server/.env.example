[TEMPLATE]
# Server Configuration
PORT=5000
NODE_ENV=development

# Client URLs
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Database (MySQL / MariaDB) — set real values in server/.env, never commit secrets
DB_HOST=localhost
DB_PORT=3306
DB_NAME=greenleaf_school
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Admin API protection (Phase 3.3 stopgap until real auth phase)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
