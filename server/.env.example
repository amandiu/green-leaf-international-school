# Server Configuration
PORT=5000
NODE_ENV=development

# Client URLs
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Public site origin (Phase B.7 SEO) — the CANONICAL production
# origin used for canonical URLs, sitemap.xml <loc> values and the
# robots.txt Sitemap: line. Takes precedence over CLIENT_URL for
# SEO. Leave unset in dev (CLIENT_URL is used as a dev fallback).
# SITE_URL=https://www.example.com

# Database (MySQL / MariaDB) — set real values in server/.env, never commit secrets
DB_HOST=localhost
DB_PORT=3306
DB_NAME=greenleaf_school
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Admin session signing secret (Admin auth phase)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start without it (minimum 32 characters).
AUTH_SECRET=

# Admin session lifetime in hours (default 12)
SESSION_TTL_HOURS=12

# DEPRECATED transition secret for scripts/tests only (may be
# removed once no script depends on it). Browser admin usage goes
# through POST /api/auth/login + HttpOnly session cookie instead.
ADMIN_TOKEN=

# ---- Password reset email (Phase 2) ----
# SMTP credentials for delivering forgot-password verification codes.
# NEVER commit real credentials — set them in server/.env only.
# When SMTP_HOST is empty AND NODE_ENV is not "production", the
# reset email is rendered to the SERVER CONSOLE instead of being
# sent (development preview). In production an empty SMTP_HOST makes
# the send fail safely (the client still only sees the generic
# forgot-password response).
#
# REAL EMAIL MODE (production-oriented projects — the code must
# reach the user's INBOX, never depend on the server console):
#   Gmail example:
#     SMTP_HOST=smtp.gmail.com
#     SMTP_PORT=587            (STARTTLS; use 465 + SMTP_SECURE=true for implicit TLS)
#     SMTP_SECURE=false
#     SMTP_USER=your.real.address@gmail.com
#     SMTP_PASSWORD=<16-char Gmail APP PASSWORD — Google Account →
#                   Security → 2-Step Verification → App passwords;
#                   the normal Gmail login password is REJECTED by SMTP>
#     MAIL_FROM=your.real.address@gmail.com   (must equal SMTP_USER for Gmail)
#   After filling: restart the server, then verify WITHOUT sending
#   an email:  node scripts/diagnose-smtp.mjs
#
SMTP_HOST=
SMTP_PORT=587
# "true" for port 465 (implicit TLS), "false"/unset for STARTTLS (587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# From header for reset emails (falls back to the site identity name)
MAIL_FROM=
# Development ONLY (never set in production): "true" prints the
# verification code in the dev console preview instead of [redacted].
MAIL_DEV_SHOW_CODE=

# Password reset code lifetime in minutes (default 10, max 120)
PASSWORD_RESET_CODE_EXPIRY_MINUTES=10
