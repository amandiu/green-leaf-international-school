[TEMPLATE]
# Server Configuration
PORT=5000
NODE_ENV=development

# Client URLs
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Database (MySQL / MariaDB) — set real values in server/.env, never commit secrets
DB_HOST=localhost
DB_PORT=3306
DB_NAME=greenleaf_school
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Admin session signing secret (Admin auth phase)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start without it (minimum 32 characters).
AUTH_SECRET=

# Admin session lifetime in hours (default 12)
SESSION_TTL_HOURS=12

# DEPRECATED transition secret for scripts/tests only (may be
# removed once no script depends on it). Browser admin usage goes
# through POST /api/auth/login + HttpOnly session cookie instead.
ADMIN_TOKEN=
