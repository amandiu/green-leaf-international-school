{
  "name": "green-leaf-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exitcrash src/server.js",
    "start": "node src/server.js",
    "lint": "eslint . --ext js --report-unused-disable-directives --max-warnings 0",
    "db:migrate": "node src/scripts/dbRun.js migrate",
